{
  "name": "@dunx/openapi",
  "version": "3.1.0",
  "description": "OpenAPI 3.1 documents for dunx controllers, generated from the schemas the routes already validate, with Swagger UI mounted over them",
  "keywords": [
    "bun",
    "dunx",
    "openapi",
    "swagger",
    "zod"
  ],
  "homepage": "https://github.com/petarzarkov/dunx/tree/main/packages/openapi#readme",
  "license": "MIT",
  "author": {
    "name": "Petar Zarkov",
    "email": "pzarko1@gmail.com",
    "url": "https://github.com/petarzarkov"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petarzarkov/dunx.git",
    "directory": "packages/openapi"
  },
  "bin": {
    "dunx-openapi": "dist/cli.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "test": "bun test --bail",
    "test:cov": "bun test --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "swagger-ui-dist": "^5.32.14"
  },
  "devDependencies": {
    "@dunx/core": "workspace:*",
    "@dunx/http": "workspace:*",
    "@dunx/testing": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@dunx/core": "workspace:*",
    "@dunx/http": "workspace:*",
    "@types/bun": ">=1.3.0",
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "@types/bun": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
