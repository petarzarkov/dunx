{
  "name": "@dunx/openapi",
  "version": "3.6.0",
  "description": "OpenAPI 3.1 documents for dunx controllers, generated from the schemas the routes already validate, with Swagger UI or Scalar mounted over them",
  "keywords": [
    "bun",
    "dunx",
    "openapi",
    "scalar",
    "swagger",
    "zod"
  ],
  "homepage": "https://github.com/petarzarkov/dunx/tree/main/packages/openapi#readme",
  "license": "MIT",
  "author": {
    "name": "Petar Zarkov",
    "email": "pzarko1@gmail.com",
    "url": "https://github.com/petarzarkov"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petarzarkov/dunx.git",
    "directory": "packages/openapi"
  },
  "bin": {
    "dunx-openapi": "dist/cli.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./swagger": {
      "types": "./dist/swagger/index.d.ts",
      "import": "./dist/swagger/index.js"
    },
    "./scalar": {
      "types": "./dist/scalar/index.d.ts",
      "import": "./dist/scalar/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "test": "bun test --bail",
    "test:cov": "bun test --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@dunx/core": "workspace:*",
    "@dunx/http": "workspace:*",
    "@dunx/testing": "workspace:*",
    "@scalar/api-reference": "1.68.0",
    "swagger-ui-dist": "5.32.14",
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "@dunx/core": "workspace:*",
    "@dunx/http": "workspace:*",
    "@scalar/api-reference": "^1.68.0",
    "@types/bun": ">=1.4.1",
    "swagger-ui-dist": "^5.32.14",
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "@scalar/api-reference": {
      "optional": true
    },
    "@types/bun": {
      "optional": true
    },
    "swagger-ui-dist": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.1"
  }
}
