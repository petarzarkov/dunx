{
  "name": "@dunx/testing",
  "version": "2.2.1",
  "description": "Test harness for dunx apps: a container with providers replaced in place, and a real Bun.serve on port 0",
  "keywords": [
    "bun",
    "dependency-injection",
    "dunx",
    "integration-testing",
    "mock",
    "override",
    "testing"
  ],
  "homepage": "https://github.com/petarzarkov/dunx/tree/main/packages/testing#readme",
  "license": "MIT",
  "author": {
    "name": "Petar Zarkov",
    "email": "pzarko1@gmail.com",
    "url": "https://github.com/petarzarkov"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petarzarkov/dunx.git",
    "directory": "packages/testing"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "test": "bun test --bail",
    "test:cov": "bun test --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@dunx/core": "workspace:*",
    "@dunx/http": "workspace:*"
  },
  "peerDependencies": {
    "@dunx/core": "workspace:*",
    "@dunx/http": "workspace:*",
    "@types/bun": ">=1.3.0"
  },
  "peerDependenciesMeta": {
    "@types/bun": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
