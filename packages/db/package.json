{
  "name": "@dunx/db",
  "version": "0.0.0",
  "description": "SQL and SQLite access built on Bun.SQL and bun:sqlite",
  "keywords": [
    "bun",
    "database",
    "dunx",
    "postgres",
    "sql",
    "sqlite"
  ],
  "homepage": "https://github.com/petarzarkov/dunx/tree/main/packages/db#readme",
  "license": "MIT",
  "author": {
    "name": "Petar Zarkov",
    "email": "pzarko1@gmail.com",
    "url": "https://github.com/petarzarkov"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/petarzarkov/dunx",
    "directory": "packages/db"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "test": "bun test --bail",
    "test:cov": "bun test --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dunx/core": "workspace:*"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
