{
  "name": "@dunx/transform",
  "version": "3.0.5",
  "description": "Load-time transform that records constructor dependencies for the dunx container",
  "keywords": [
    "bun",
    "bun-plugin",
    "dependency-injection",
    "dunx",
    "transform"
  ],
  "homepage": "https://github.com/petarzarkov/dunx/tree/main/packages/transform#readme",
  "license": "MIT",
  "author": {
    "name": "Petar Zarkov",
    "email": "pzarko1@gmail.com",
    "url": "https://github.com/petarzarkov"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petarzarkov/dunx.git",
    "directory": "packages/transform"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preload": {
      "types": "./dist/preload.d.ts",
      "import": "./dist/preload.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "test": "bun test --bail",
    "test:cov": "bun test --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "oxc-parser": "0.142.0"
  },
  "peerDependencies": {
    "@types/bun": ">=1.3.0"
  },
  "peerDependenciesMeta": {
    "@types/bun": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
