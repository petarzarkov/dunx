{
  "name": "@dunx/dashboard",
  "version": "3.0.2",
  "description": "An opt-in operations page for a running dunx app: routes, the provider graph, gateways, config and runtime health, with bull-board mounted for the queues",
  "keywords": [
    "bull-board",
    "bullmq",
    "bun",
    "dashboard",
    "dunx",
    "jobs",
    "monitoring",
    "observability",
    "queue",
    "redis"
  ],
  "homepage": "https://github.com/petarzarkov/dunx/tree/main/packages/dashboard#readme",
  "license": "MIT",
  "author": {
    "name": "Petar Zarkov",
    "email": "pzarko1@gmail.com",
    "url": "https://github.com/petarzarkov"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petarzarkov/dunx.git",
    "directory": "packages/dashboard"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../internal/dashboard-ui/scripts/build.ts && bun ../../scripts/build-package.ts",
    "test": "bun test --bail",
    "test:cov": "bun test --coverage",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@bull-board/api": "^8.6.0",
    "@bull-board/bun": "^8.6.0",
    "@bull-board/ui": "^8.6.0",
    "@dunx/core": "workspace:*",
    "@dunx/http": "workspace:*",
    "bullmq": "^6.0.5"
  },
  "peerDependencies": {
    "@bull-board/api": "^8.6.0",
    "@bull-board/bun": "^8.6.0",
    "@bull-board/ui": "^8.6.0",
    "@dunx/core": "workspace:*",
    "@dunx/http": "workspace:*",
    "@types/bun": ">=1.3.0"
  },
  "peerDependenciesMeta": {
    "@bull-board/api": {
      "optional": true
    },
    "@bull-board/bun": {
      "optional": true
    },
    "@bull-board/ui": {
      "optional": true
    },
    "@types/bun": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.0"
  }
}
