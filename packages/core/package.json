  },
  "repository": {
    "type": "git",
    "url": "https://github.com/petarzarkov/dunx",
    "directory": "packages/core"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
