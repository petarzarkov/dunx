{
  "name": "@dunx/core",
  "version": "3.9.6",
  "description": "DI container, modules, lifecycle and the injectable Logger contract for the dunx framework",
  "keywords": [
    "bun",
    "core",
    "dependency-injection",
    "dunx",
    "logger",
    "opentelemetry"
  ],
  "homepage": "https://github.com/petarzarkov/dunx/tree/main/packages/core#readme",
  "license": "MIT",
  "author": {
    "name": "Petar Zarkov",
    "email": "pzarko1@gmail.com",
    "url": "https://github.com/petarzarkov"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petarzarkov/dunx.git",
    "directory": "packages/core"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./otel": {
      "types": "./dist/otel/index.d.ts",
      "import": "./dist/otel/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "test": "bun test --bail",
    "test:cov": "bun test --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-node": "2.11.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.4.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.1"
  }
}
