{
  "name": "@dunx/infra",
  "version": "3.9.5",
  "description": "Database, Redis, queue, AMQP, schedule, storage, image and logging infrastructure for dunx. drizzle over bun:sqlite and Bun.SQL, bullmq over Bun.RedisClient, rabbitmq-client for RabbitMQ, plus Bun.file, Bun.Glob, Bun.S3Client, Bun.Image and @arkv/logger",
  "keywords": [
    "amqp",
    "avif",
    "broker",
    "bullmq",
    "bun",
    "cache",
    "cron",
    "database",
    "drizzle",
    "drizzle-orm",
    "dunx",
    "email",
    "files",
    "glob",
    "image",
    "jobs",
    "logger",
    "mail",
    "messaging",
    "nodemailer",
    "postgres",
    "pubsub",
    "queue",
    "rabbitmq",
    "react-email",
    "redis",
    "resend",
    "resize",
    "s3",
    "schedule",
    "scheduler",
    "smtp",
    "sql",
    "sqlite",
    "storage",
    "templates",
    "thumbnail",
    "valkey",
    "webp"
  ],
  "homepage": "https://github.com/petarzarkov/dunx/tree/main/packages/infra#readme",
  "license": "MIT",
  "author": {
    "name": "Petar Zarkov",
    "email": "pzarko1@gmail.com",
    "url": "https://github.com/petarzarkov"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petarzarkov/dunx.git",
    "directory": "packages/infra"
  },
  "bin": {
    "dunx-email": "dist/email/cli.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    },
    "./redis": {
      "types": "./dist/redis/index.d.ts",
      "import": "./dist/redis/index.js"
    },
    "./cache": {
      "types": "./dist/cache/index.d.ts",
      "import": "./dist/cache/index.js"
    },
    "./email": {
      "types": "./dist/email/index.d.ts",
      "import": "./dist/email/index.js"
    },
    "./email/react": {
      "types": "./dist/email/react/index.d.ts",
      "import": "./dist/email/react/index.js"
    },
    "./email/resend": {
      "types": "./dist/email/resend/index.d.ts",
      "import": "./dist/email/resend/index.js"
    },
    "./email/smtp": {
      "types": "./dist/email/smtp/index.d.ts",
      "import": "./dist/email/smtp/index.js"
    },
    "./files": {
      "types": "./dist/files/index.d.ts",
      "import": "./dist/files/index.js"
    },
    "./images": {
      "types": "./dist/images/index.d.ts",
      "import": "./dist/images/index.js"
    },
    "./schedule": {
      "types": "./dist/schedule/index.d.ts",
      "import": "./dist/schedule/index.js"
    },
    "./queue": {
      "types": "./dist/queue/index.d.ts",
      "import": "./dist/queue/index.js"
    },
    "./logger": {
      "types": "./dist/logger/index.d.ts",
      "import": "./dist/logger/index.js"
    },
    "./pagination": {
      "types": "./dist/pagination/index.d.ts",
      "import": "./dist/pagination/index.js"
    },
    "./pagination/cursor": {
      "types": "./dist/pagination/cursor-only.d.ts",
      "import": "./dist/pagination/cursor-only.js"
    },
    "./amqp": {
      "types": "./dist/amqp/index.d.ts",
      "import": "./dist/amqp/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "test": "bun test --bail",
    "test:cov": "bun test --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arkv/logger": "0.13.0",
    "@arkv/timezones": "0.0.2"
  },
  "devDependencies": {
    "@dunx/core": "workspace:*",
    "@react-email/render": "2.1.0",
    "@types/react": "19.2.18",
    "bullmq": "6.3.4",
    "drizzle-orm": "0.45.2",
    "ioredis": "6.0.0",
    "nodemailer": "10.0.9",
    "rabbitmq-client": "5.0.8",
    "react": "19.2.8",
    "resend": "6.28.0"
  },
  "peerDependencies": {
    "@dunx/core": "workspace:*",
    "@react-email/render": "^2.0.0",
    "@types/bun": ">=1.4.1",
    "bullmq": "^6.0.5",
    "drizzle-orm": "^0.45.2",
    "ioredis": ">=5.0.0",
    "nodemailer": "^10.0.0",
    "rabbitmq-client": "^5.0.8",
    "react": ">=18.0.0",
    "resend": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@react-email/render": {
      "optional": true
    },
    "@types/bun": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "nodemailer": {
      "optional": true
    },
    "rabbitmq-client": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "resend": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.1"
  }
}
