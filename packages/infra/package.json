{
  "name": "@dunx/infra",
  "version": "0.0.0",
  "description": "Database, Redis, storage and image infrastructure built on Bun.SQL, bun:sqlite, Bun.RedisClient, Bun.file, Bun.Glob, Bun.S3Client and Bun.Image",
  "keywords": [
    "avif",
    "bun",
    "cache",
    "database",
    "dunx",
    "files",
    "glob",
    "image",
    "postgres",
    "pubsub",
    "redis",
    "resize",
    "s3",
    "sql",
    "sqlite",
    "storage",
    "thumbnail",
    "valkey",
    "webp"
  ],
  "homepage": "https://github.com/petarzarkov/dunx/tree/main/packages/infra#readme",
  "license": "MIT",
  "author": {
    "name": "Petar Zarkov",
    "email": "pzarko1@gmail.com",
    "url": "https://github.com/petarzarkov"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/petarzarkov/dunx",
    "directory": "packages/infra"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    },
    "./redis": {
      "types": "./dist/redis/index.d.ts",
      "import": "./dist/redis/index.js"
    },
    "./files": {
      "types": "./dist/files/index.d.ts",
      "import": "./dist/files/index.js"
    },
    "./images": {
      "types": "./dist/images/index.d.ts",
      "import": "./dist/images/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "test": "bun test --bail",
    "test:cov": "bun test --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dunx/core": "workspace:*"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
