{
  "name": "@dunx/infra",
  "version": "0.1.1",
  "description": "Database, Redis, queue, storage, image and logging infrastructure for dunx. drizzle over bun:sqlite and Bun.SQL, bullmq over Bun.RedisClient, plus Bun.file, Bun.Glob, Bun.S3Client, Bun.Image and @arkv/logger",
  "keywords": [
    "avif",
    "bullmq",
    "bun",
    "cache",
    "database",
    "drizzle",
    "drizzle-orm",
    "dunx",
    "files",
    "glob",
    "image",
    "jobs",
    "logger",
    "postgres",
    "pubsub",
    "queue",
    "redis",
    "resize",
    "s3",
    "sql",
    "sqlite",
    "storage",
    "thumbnail",
    "valkey",
    "webp"
  ],
  "homepage": "https://github.com/petarzarkov/dunx/tree/main/packages/infra#readme",
  "license": "Apache-2.0",
  "author": {
    "name": "Petar Zarkov",
    "email": "pzarko1@gmail.com",
    "url": "https://github.com/petarzarkov"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petarzarkov/dunx.git",
    "directory": "packages/infra"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    },
    "./redis": {
      "types": "./dist/redis/index.d.ts",
      "import": "./dist/redis/index.js"
    },
    "./files": {
      "types": "./dist/files/index.d.ts",
      "import": "./dist/files/index.js"
    },
    "./images": {
      "types": "./dist/images/index.d.ts",
      "import": "./dist/images/index.js"
    },
    "./queue": {
      "types": "./dist/queue/index.d.ts",
      "import": "./dist/queue/index.js"
    },
    "./logger": {
      "types": "./dist/logger/index.d.ts",
      "import": "./dist/logger/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "test": "bun test --bail",
    "test:cov": "bun test --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arkv/logger": "^0.8.1"
  },
  "devDependencies": {
    "@dunx/core": "workspace:*",
    "bullmq": "^6.0.5",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0"
  },
  "peerDependencies": {
    "@dunx/core": "workspace:*",
    "@types/bun": ">=1.3.0",
    "bullmq": "^6.0.5",
    "drizzle-orm": "^0.45.2",
    "ioredis": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@types/bun": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    },
    "drizzle-orm": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
