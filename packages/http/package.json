{
  "name": "@dunx/http",
  "version": "1.1.0",
  "description": "Bun.serve adapter for the dunx framework: controllers, middleware and WebSocket gateways",
  "keywords": [
    "bun",
    "controller",
    "dunx",
    "http",
    "pubsub",
    "realtime",
    "router",
    "websocket"
  ],
  "homepage": "https://github.com/petarzarkov/dunx/tree/main/packages/http#readme",
  "license": "MIT",
  "author": {
    "name": "Petar Zarkov",
    "email": "pzarko1@gmail.com",
    "url": "https://github.com/petarzarkov"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petarzarkov/dunx.git",
    "directory": "packages/http"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "test": "bun test --bail",
    "test:cov": "bun test --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arkv/shared": "^0.8.0"
  },
  "devDependencies": {
    "@dunx/core": "workspace:*"
  },
  "peerDependencies": {
    "@dunx/core": "workspace:*",
    "@types/bun": ">=1.3.0"
  },
  "peerDependenciesMeta": {
    "@types/bun": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
