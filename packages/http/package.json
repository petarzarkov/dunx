{
  "name": "@dunx/http",
  "version": "3.8.1",
  "description": "Bun.serve adapter for the dunx framework: controllers, middleware and WebSocket gateways",
  "keywords": [
    "bun",
    "connect-rpc",
    "controller",
    "dunx",
    "grpc-web",
    "http",
    "pubsub",
    "realtime",
    "router",
    "websocket"
  ],
  "homepage": "https://github.com/petarzarkov/dunx/tree/main/packages/http#readme",
  "license": "MIT",
  "author": {
    "name": "Petar Zarkov",
    "email": "pzarko1@gmail.com",
    "url": "https://github.com/petarzarkov"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petarzarkov/dunx.git",
    "directory": "packages/http"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./connect": {
      "types": "./dist/connect.d.ts",
      "import": "./dist/connect.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "test": "bun test --bail",
    "test:cov": "bun test --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@arkv/shared": "0.8.0"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "2.15.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "@dunx/core": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@connectrpc/connect": "^2.2.0",
    "@dunx/core": "workspace:*",
    "@types/bun": ">=1.4.1"
  },
  "peerDependenciesMeta": {
    "@bufbuild/protobuf": {
      "optional": true
    },
    "@connectrpc/connect": {
      "optional": true
    },
    "@types/bun": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4.1"
  }
}
