#!/usr/bin/env sh

# pre-commit only sees staged files, and it does not run at all in a linked
# worktree - core.hooksPath is relative and .husky/_ is gitignored, so git
# finds no hooks there and skips them silently. Either way the unformatted
# file reaches CI and fails `bun run format:check`. Catch it here instead.
unformatted=$(bunx oxfmt --list-different .)

[ -z "$unformatted" ] && exit 0

bunx oxfmt --write . >/dev/null

echo "pre-push: these files were not formatted, and CI would have failed on them:"
echo "$unformatted" | sed 's/^/  /'
echo ""
echo "oxfmt has now fixed them in your working tree. Commit the change, then push again."
exit 1
