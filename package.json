{
  "name": "dunx",
  "version": "0.0.0",
  "private": true,
  "description": "The dunx monorepo",
  "homepage": "https://github.com/petarzarkov/dunx#readme",
  "license": "MIT",
  "author": {
    "name": "Petar Zarkov",
    "email": "pzarko1@gmail.com",
    "url": "https://github.com/petarzarkov"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/petarzarkov/dunx"
  },
  "workspaces": [
    "packages/*",
    "tools/*",
    "internal/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "husky || true",
    "install:clean": "find . -name node_modules -type d -prune -exec rm -rf {} + && rm -f bun.lock && bun install",
    "build": "bun scripts/build-all.ts",
    "ci": "bun ./scripts/ci.ts",
    "test": "bun run --parallel --filter '*' test",
    "test:cov": "bun test ./packages ./tools ./scripts --coverage --path-ignore-patterns='**/templates/**' --path-ignore-patterns='**/tmp/**' && bun run gen:cov",
    "lint": "oxlint --fix .",
    "lint:check": "oxlint --max-warnings 0 .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "bun run --parallel --filter '*' typecheck",
    "docs:build": "bun run --filter '@dunx/docs' build",
    "docs:dev": "bun run --filter '@dunx/docs' dev",
    "gen:cov": "bun ./scripts/coverage-report.ts",
    "gen:readme": "bun ./scripts/update-readme.ts",
    "sync:templates": "bun ./scripts/sync-templates.ts",
    "check:scaffolds": "bun ./scripts/check-scaffolds.ts",
    "version": "bun ./scripts/version.ts",
    "version:dry-run": "DRY_RUN=true bun ./scripts/version.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "26.2.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{js,jsx,mjs,cjs,json,jsonc,md}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  }
}
