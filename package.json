{
  "name": "dunx",
  "version": "0.0.0",
  "private": true,
  "description": "The dunx monorepo",
  "homepage": "https://github.com/petarzarkov/dunx#readme",
  "license": "MIT",
  "author": {
    "name": "Petar Zarkov",
    "email": "pzarko1@gmail.com",
    "url": "https://github.com/petarzarkov"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/petarzarkov/dunx"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "tools/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "husky || true",
    "install:clean": "find . -name node_modules -type d -prune -exec rm -rf {} + && rm -f bun.lock && bun install",
    "build": "bun scripts/build-all.ts",
    "test": "bun run --filter '*' test",
    "test:cov": "bun test ./packages ./scripts --coverage --path-ignore-patterns='**/templates/**' && bun run gen:cov",
    "lint": "oxlint --fix .",
    "lint:check": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "bun run --filter '*' typecheck",
    "docs:build": "bun run --filter '@dunx/docs' build",
    "docs:dev": "bun run --filter '@dunx/docs' dev",
    "gen:cov": "bun ./scripts/coverage-report.ts",
    "gen:readme": "bun ./scripts/update-readme.ts",
    "version": "bun ./scripts/version.ts",
    "version:dry-run": "DRY_RUN=true bun ./scripts/version.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "26.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.2.0",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "lint-staged": {
    "*.ts": [
      "bun run lint",
      "bun run format"
    ]
  }
}
