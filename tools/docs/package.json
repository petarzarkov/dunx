{
  "name": "@dunx/docs",
  "version": "0.0.0",
  "private": true,
  "description": "The dunx documentation site. Private tooling, never published.",
  "type": "module",
  "scripts": {
    "build": "bun run generate && bun ./scripts/build.ts",
    "dev": "bun run generate && bun --hot ./index.html",
    "generate": "bun ./scripts/generate.ts",
    "preview": "bun ./scripts/build.ts && bunx serve dist",
    "test": "bun test --bail",
    "typecheck": "bun run generate && tsc --noEmit"
  },
  "dependencies": {
    "@mantine/core": "^8.3.6",
    "@mantine/hooks": "^8.3.6",
    "@mantine/spotlight": "^8.3.6",
    "oxc-parser": "0.142.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2"
  }
}
